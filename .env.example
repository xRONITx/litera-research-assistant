# Frontend settings. These public auth values are intended for the browser.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_REQUIRE_AUTH=false

# Backend settings (copy to backend/.env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried in order when the selected Gemini model is unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=gemini
SUPABASE_URL=
SUPABASE_ANON_KEY=
REQUIRE_AUTH=false
DAILY_RESEARCH_LIMIT=3
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
SEMANTIC_SCHOLAR_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
